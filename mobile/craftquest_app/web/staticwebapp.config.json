{
  "routes": [
    {
      "route": "/join/*",
      "rewrite": "https://api.craftquestai.com/join/*"
    },
    {
      "route": "/.well-known/assetlinks.json",
      "rewrite": "https://api.craftquestai.com/.well-known/assetlinks.json"
    },
    {
      "route": "/.well-known/apple-app-site-association",
      "rewrite": "https://api.craftquestai.com/.well-known/apple-app-site-association"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/.well-known/*",
      "/*.{css,scss,js,map,json,wasm,png,jpg,jpeg,gif,svg,webp,ico,woff,woff2,ttf,otf,mp3,wav,ogg,txt}"
    ]
  },
  "mimeTypes": {
    ".mp3": "audio/mpeg",
    ".wav": "audio/wav",
    ".ogg": "audio/ogg"
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
